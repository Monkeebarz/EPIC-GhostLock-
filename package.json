{
  "name": "epic-ghostlock",
  "version": "1.0.0",
  "private": true,
  "description": "EPIC Ghost Lock Discord security and verification bot",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test tests/purge.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "register": "tsx src/commands/register.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@discordjs/builders": "^1.13.0",
    "@discordjs/rest": "^2.6.0",
    "discord-api-types": "^0.38.25",
    "discord.js": "^14.21.0",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
